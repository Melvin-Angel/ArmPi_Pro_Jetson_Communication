<launch>

  <node name="chassis_control" pkg="chassis_control" type="chassis_control_node.py" required="true" output="screen" />
  <node name="visual_processing" pkg="visual_processing" type="visual_processing_node.py" required="true" output="screen" />

  <node name="face_detect" pkg="face_detect" type="face_detect_node.py" required="true" output="screen" />
  <node name="visual_patrol" pkg="visual_patrol" type="visual_patrol_node.py" required="true" output="screen" />
  <node name="color_tracking" pkg="color_tracking" type="color_tracking_node.py" required="true" output="screen" />
  <node name="apriltag_detect" pkg="apriltag_detect" type="apriltag_detect_node.py" required="true" output="screen" />


  <node name="armpi_to_jetson"
        pkg="armpi_jetson_bridge"
        type="armpi_to_jetson.py"
        output="screen"
        respawn="true"
        respawn_delay="5">
    <param name="bind_host" value="172.20.10.3" />
    <param name="port" value="8765" />
  </node>
  <include file="$(find armpi_jetson_bridge)/launch/wheel_odometry_startup.launch" />
</launch>
